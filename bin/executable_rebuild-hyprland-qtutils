#!/usr/bin/env bash
# rebuild-hyprland-qtutils: rebuild hyprland-qt-support and hyprland-qtutils
# from the solopasha/hyprland COPR's source RPMs against the currently
# installed Qt. Needed when Fedora ships a new Qt minor before the COPR
# catches up. See HYPRLAND-QTUTILS-REBUILD.md for the why.

set -euo pipefail

PKGS=(hyprland-qt-support hyprland-qtutils)
WORKDIR="$(mktemp -d -t hyprland-qtutils-rebuild.XXXXXX)"
trap 'rm -rf "$WORKDIR"' EXIT

echo ">>> Fetching source RPMs into $WORKDIR"
( cd "$WORKDIR" && dnf download --source "${PKGS[@]}" )

echo ">>> Preparing rpmbuild tree"
rpmdev-setuptree
rpm -i "$WORKDIR"/*.src.rpm

SPECS=()
for p in "${PKGS[@]}"; do
    SPECS+=("$HOME/rpmbuild/SPECS/$p.spec")
done

echo ">>> Installing build dependencies (sudo)"
sudo dnf builddep -y "${SPECS[@]}"

echo ">>> Building (qt-support first; qtutils depends on it)"
for spec in "${SPECS[@]}"; do
    rpmbuild -ba "$spec"
done

RPMS=()
for p in "${PKGS[@]}"; do
    mapfile -t found < <(ls -t "$HOME"/rpmbuild/RPMS/x86_64/"$p"-[0-9]*.rpm 2>/dev/null | grep -v debug | head -1)
    if [[ ${#found[@]} -eq 0 ]]; then
        echo "ERROR: built RPM for $p not found" >&2
        exit 1
    fi
    RPMS+=("${found[0]}")
done

echo ">>> Installing built RPMs (sudo):"
printf '   %s\n' "${RPMS[@]}"
sudo dnf install -y "${RPMS[@]}"

echo ">>> Done. The Hyprland qtutils warning should be gone on next login."
