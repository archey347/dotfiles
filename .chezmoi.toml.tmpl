[git]
    autoCommit = true
    autoPush = true

[data]
    git_name          = {{ promptStringOnce . "git_name" "Git name" | quote }}
    git_email         = {{ promptStringOnce . "git_email" "Git email" | quote }}
    git_signingkey    = {{ promptStringOnce . "git_signingkey" "Git signing key" | quote }}
    gpg_guest         = {{ promptBoolOnce . "gpg_guest" "Is this a gpg_guest host (no local gpg-agent; socket forwarded over SSH)" }}
    is_hyprland       = {{ promptBoolOnce . "is_hyprland" "Is this a Hyprland system" }}
    is_work_machine   = {{ promptBoolOnce . "is_work_machine" "Is this a work machine (uses a secondary chezmoi source dir)" }}
{{- if promptBoolOnce . "is_hyprland" "Is this a Hyprland system" }}
    aq_drm_devices    = {{ promptStringOnce . "aq_drm_devices" "AQ_DRM_DEVICES (e.g. /dev/dri/card1:/dev/dri/card0, blank to skip)" | quote }}
    libva_driver_name = {{ promptStringOnce . "libva_driver_name" "LIBVA_DRIVER_NAME (e.g. iHD, radeonsi, blank to skip)" | quote }}
    kb_layout         = {{ promptStringOnce . "kb_layout" "Keyboard layout (e.g. us, gb, de)" | quote }}
    monitor_profiles  = {{ if hasKey . "monitor_profiles" }}{{ .monitor_profiles | toJson }}{{ else }}[]{{ end }}

# Desktop theme — palette consumed by waybar, mako, wofi and ghostty.
# Edit the values below to reskin this machine; copy a ready-made block from
# THEMES.md in the chezmoi source dir to switch to a different theme.
# Seeded default is the "Gruvbox dark" profile.
[data.theme]
{{- if hasKey . "theme" }}
{{- range $k, $v := .theme }}
    {{ $k | quote }} = {{ $v | quote }}
{{- end }}
{{- else }}
    background         = "282828"
    background_rgb     = "40, 40, 40"
    surface            = "3c3836"
    surface_rgb        = "60, 56, 54"
    surface_hover      = "504945"
    surface_hover_rgb  = "80, 73, 69"
    accent             = "fe8019"
    accent_rgb         = "254, 128, 25"
    accent_strong      = "665c54"
    accent_strong_rgb  = "102, 92, 84"
    text               = "ebdbb2"
    text_rgb           = "235, 219, 178"
    error              = "fb4934"
    error_rgb          = "251, 73, 52"
    success            = "b8bb26"
    success_rgb        = "184, 187, 38"
    info               = "83a598"
    info_rgb           = "131, 165, 152"
{{- end }}
{{- if hasKey . "kb_devices" }}

[data.kb_devices]
{{- range $name, $layout := .kb_devices }}
    {{ $name | quote }} = {{ $layout | quote }}
{{- end }}
{{- end }}
{{- end }}
