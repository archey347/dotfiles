# Git branch function for prompt
__git_branch() {
    local branch=$(git rev-parse --abbrev-ref HEAD 2> /dev/null)

    if [[ -n "$branch" ]]; then
        echo " ($branch)"
    fi
}

# Blank line before each prompt, except the shell's very first one
__prompt_blank_line() {
    if [[ -n "$__prompt_primed" ]]; then
        printf '\n'
    fi
    __prompt_primed=1
}
PROMPT_COMMAND="__prompt_blank_line${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# Set my preferred prompt string
export PS1='\[$(tput setaf 39)\]\u\[$(tput setaf 81)\]@\[$(tput setaf 77)\]\h\[$(tput setaf 226)\]:\w\[$(tput setaf 245)\]$(__git_branch)\[$(tput sgr0)\]\n$ '
