# Appearance — flat card; hangs from the bar, right edge flush with the power key
font=Montserrat SemiBold 11
background-color=#{{ .theme.surface }}
text-color=#{{ .theme.text }}
border-color=#{{ .theme.text }}55
border-size=1
border-radius=8
padding=14
margin=4,8,6,8
outer-margin=0,3,0,0
width=360
max-icon-size=48
icons=1
markup=1
actions=1
format=<b>%s</b>\n<span fgalpha='70%%'>%b</span>
progress-color=over #{{ .theme.accent }}5c

# Layout
max-visible=4
layer=overlay
anchor=top-right

# Behavior
default-timeout=20000
on-button-left=dismiss
on-button-right=dismiss-all
group-by=app-name

[urgency=low]
border-color=#{{ .theme.text }}30

[urgency=critical]
border-color=#{{ .theme.error }}
default-timeout=0
