# hyprlock — lock screen with a cycling photo slideshow.
# Managed by chezmoi; only applied on Hyprland systems (see .chezmoiignore).
#
# Photos come from ~/Pictures/desktop-photos (same set as the wallpaper
# slideshow). The background widget fills every monitor (cover); reload_cmd
# swaps in a fresh random photo every reload_time seconds with a crossfade.

general {
    hide_cursor = true
    ignore_empty_input = true
}

# `path` is a symlink that ~/bin/lock seeds for the first frame; later photos
# come straight from reload_cmd's stdout. `color` shows until the first loads.
background {
    monitor =
    path = {{ .chezmoi.homeDir }}/.cache/lock-photo
    color = rgba(000000ff)
    reload_time = 60
    reload_cmd = {{ .chezmoi.homeDir }}/.config/hypr/random-lock-photo.sh
    crossfade_time = 1.0
}

# Dark translucent field + white text reads better over photos than hyprlock's
# stock light field; everything else here is left at its default.
input-field {
    monitor =
    size = 280, 55
    rounding = 12
    inner_color = rgba(00000088)
    font_color = rgba(ffffffff)
    position = 0, -20
}

# Clock
label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba(ffffffff)
    font_size = 64
    font_family = Iosevka
    position = 0, 120
}

# Date
label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %d %B')"
    color = rgba(ffffffcc)
    font_size = 20
    font_family = Iosevka
    position = 0, 55
}
