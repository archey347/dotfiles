# hyprlock — lock screen with a random photo, one per lock session.
# Managed by chezmoi; only applied on Hyprland systems (see .chezmoiignore).
#
# Photos come from ~/Pictures/desktop-photos (same set as the wallpaper
# slideshow). Only the *primary* monitor shows the photo + clock; the rest are
# blacked out. "Primary" = whichever monitor was focused when the screen
# locked — ~/bin/lock resolves it and writes $PRIMARY into the sourced file
# below before launching. If the file is missing or $PRIMARY is empty, the
# widgets fall back to every monitor (monitor = ). The photo itself is picked
# once by ~/bin/lock when the lock starts and stays fixed for the whole
# session — there's no reload_cmd swapping it in mid-session (an earlier
# version of this tried a periodic reload_cmd swap; hyprlock v0.9.2 fired it
# almost immediately after locking rather than waiting reload_time, and the
# reload itself — even returning the unchanged photo — caused a brief
# vertical squash/recover glitch. Simplest fix: no reload, no glitch. The
# next photo is picked on the next lock.)
# $CLOCK_X/$CLOCK_Y and $DATE_X/$DATE_Y come from ~/bin/lock, which reads a
# `__clockpos_X_Y` tag off the chosen photo's filename (n prefixes a negative
# number) so a photo can move the clock off its subject; untagged photos fall
# back to the original position. ~/bin/lock also rescales for the current
# monitor's aspect ratio. See ~/bin/lock for the tag format.
source = {{ .chezmoi.homeDir }}/.cache/hyprlock-primary.conf
source = {{ .chezmoi.homeDir }}/.cache/hyprlock-clock-position.conf

general {
    hide_cursor = true
    ignore_empty_input = true
}
{{- if .has_fingerprint_reader }}

# Fingerprint unlock. hyprlock talks to fprintd over D-Bus in a thread
# separate from the password prompt, so an enrolled finger unlocks while the
# password field stays usable. Only emitted on machines with a reader (see
# has_fingerprint_reader in chezmoi data); the other laptop has none.
# NB: /etc/pam.d/hyprlock must point at password-auth, NOT login — the login
# stack pulls in pam_fprintd, which blocks the password path for ~a minute.
auth {
    fingerprint {
        enabled = true
    }
}
{{- end }}

# Black fill on every monitor, drawn first so it sits underneath. The photo
# background below covers it on the primary monitor; non-primary monitors keep
# this black.
background {
    monitor =
    color = rgba(000000ff)
}

# `path` is a symlink that ~/bin/lock seeds before launch and never changes
# for the rest of the session. `color` shows until it loads. Scoped to the
# primary monitor so only it shows the photo.
background {
    monitor = $PRIMARY
    path = {{ .chezmoi.homeDir }}/.cache/lock-photo
    color = rgba(000000ff)
}

# Understated field: a translucent light-grey fill lets the photo show through
# (hyprlock can't blur behind a single widget, only the whole background), with
# a thin, faint border so it sits back rather than grabbing attention. White
# text keeps it legible over the photo.
input-field {
    monitor = $PRIMARY
    size = 280, 55
    rounding = 12
    outline_thickness = 1
    outer_color = rgba(ffffff33)
    inner_color = rgba(50505066)
    font_color = rgba(ffffffff)
    position = 0, -20
}

# Clock — sits roughly one third down from the top by default (offsets are
# from centre, tuned for the laptop's 1200px-tall panel); moves per-photo via
# $CLOCK_X/$CLOCK_Y, see the source comment above.
label {
    monitor = $PRIMARY
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba(ffffffff)
    font_size = 48
    font_family = Iosevka
    position = $CLOCK_X, $CLOCK_Y
}

# Date — rides 65px below the clock, wherever that lands.
label {
    monitor = $PRIMARY
    text = cmd[update:60000] echo "$(date +'%A, %d %B')"
    color = rgba(ffffffcc)
    font_size = 15
    font_family = Iosevka
    position = $DATE_X, $DATE_Y
}
