# hyprlock — lock screen with a cycling photo slideshow.
# Managed by chezmoi; only applied on Hyprland systems (see .chezmoiignore).
#
# Photos come from ~/Pictures/desktop-photos (same set as the wallpaper
# slideshow). The `background` widget fills every monitor edge-to-edge (cover),
# so it adapts to any monitor size with no manual sizing. reload_cmd fetches a
# fresh random photo every reload_time seconds; crossfade_time fades between them.

general {
    hide_cursor = true
    grace = 0
    ignore_empty_input = true
}

# Fullscreen cycling photo. `color` is the fallback shown until the first image
# loads. `path` is a symlink that ~/bin/lock seeds before launch; subsequent
# photos come straight from reload_cmd's stdout.
background {
    monitor =
    path = {{ .chezmoi.homeDir }}/.cache/lock-photo
    color = rgba(000000ff)
    reload_time = 60
    reload_cmd = {{ .chezmoi.homeDir }}/.config/hypr/random-lock-photo.sh
    crossfade_time = 1.0
}

# Password input ring — colours ported from ~/.config/swaylock/config.
input-field {
    monitor =
    size = 280, 55
    outline_thickness = 3
    dots_size = 0.3
    dots_spacing = 0.3
    dots_center = true
    rounding = 12
    outer_color = rgba(00000044)
    inner_color = rgba(00000088)
    font_color = rgba(ffffffff)
    check_color = rgba(88888844)
    fail_color = rgba(ff5555aa)
    fade_on_empty = true
    placeholder_text = <i>Password…</i>
    fail_text = <i>$FAIL ($ATTEMPTS)</i>
    position = 0, -20
    halign = center
    valign = center
}

# Clock
label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba(ffffffff)
    font_size = 64
    font_family = Iosevka
    position = 0, 120
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %d %B')"
    color = rgba(ffffffcc)
    font_size = 20
    font_family = Iosevka
    position = 0, 55
    halign = center
    valign = center
}
