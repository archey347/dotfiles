
# #######################################################################################
# AUTOGENERATED HYPRLAND CONFIG.
# EDIT THIS CONFIG ACCORDING TO THE WIKI INSTRUCTIONS.
# #######################################################################################

# You can split this configuration into multiple files
# Create your files separately and then link them to this file like this:
# source = ~/.config/hypr/myColors.conf


################
### MONITORS ###
################

# See https://wiki.hypr.land/Configuring/Monitors/
# Layout is applied dynamically by monitor-setup.sh (work vs. home auto-detection).
# This fallback catches any monitor not explicitly handled by that script.
monitor = ,preferred,auto,1

###################
### MY PROGRAMS ###
###################

# See https://wiki.hypr.land/Configuring/Keywords/

# Set programs that you use
$terminal = ghostty
$fileManager = dolphin
$menu = wofi --show drun


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.
# Or execute your favorite apps at launch like this:

# exec-once = $terminal
# GNOME/KDE session scripts import these into systemd --user automatically;
# Hyprland doesn't. Without this, ConditionEnvironment=XDG_SESSION_CLASS=user
# (used by localsearch-3.service, the Tracker file indexer) never matches, so
# systemd skips the unit every time Nautilus tries to D-Bus-activate it —
# Nautilus then blocks ~2s waiting on the failed activation before opening.
exec-once = systemctl --user import-environment XDG_SESSION_CLASS XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP DISPLAY WAYLAND_DISPLAY
# exec-once, not exec: `exec` re-runs on every config reload, which would leave
# a second monitor-setup.sh (and its event-socket watcher) running per reload.
exec-once = ~/.config/hypr/monitor-setup.sh
# Idle handling lives in hypridle.conf (lock, then DPMS off). Replaces swayidle,
# which had no DPMS timeout — panels stayed lit indefinitely behind the lock.
exec-once = hypridle
# Polkit authentication agent. Hyprland does not process XDG autostart entries,
# and lxpolkit.desktop is OnlyShowIn=LXDE anyway, so it has to be started here —
# without it, GUI privilege prompts (blueman, virt-manager) fail silently.
exec-once = lxpolkit
exec-once = waybar
exec-once = mako
exec-once = nm-applet --indicator
exec-once = blueman-applet
exec-once = bash -c 'sleep 2 && hyprpaper'
exec-once = ~/.config/hypr/wallpaper-slideshow.sh


#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hypr.land/Configuring/Environment-variables/

# NOTE: Do NOT set GBM_BACKEND=nvidia-drm or __GLX_VENDOR_LIBRARY_NAME=nvidia
# globally — those force dGPU rendering and will break this iGPU-primary setup.
# Per-app NVIDIA offload: prime-run <app>
# In Steam launch options: prime-run %command%
# mpv: prime-run mpv <file>  (hwdec=nvdec, vo=gpu-next, gpu-api=vulkan set in ~/.config/mpv/mpv.conf)

{{- if and (hasKey . "aq_drm_devices") .aq_drm_devices }}
env = AQ_DRM_DEVICES,{{ .aq_drm_devices }}
{{- end }}
{{- if and (hasKey . "libva_driver_name") .libva_driver_name }}
env = LIBVA_DRIVER_NAME,{{ .libva_driver_name }}
{{- end }}

# Wayland hint for apps that still check this
env = MOZ_ENABLE_WAYLAND,1

# --- Toolkits: prefer Wayland, fall back to X11 where needed ---
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = QT_AUTO_SCREEN_SCALE_FACTOR,1
env = GDK_BACKEND,wayland,x11
env = SDL_VIDEODRIVER,wayland
env = CLUTTER_BACKEND,wayland
env = _JAVA_AWT_WM_NONREPARENTING,1
env = ELECTRON_OZONE_PLATFORM_HINT,auto

# --- Cursor ---
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24


