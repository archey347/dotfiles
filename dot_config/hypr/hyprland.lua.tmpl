-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    -- GNOME/KDE session scripts import these into systemd --user automatically;
    -- Hyprland doesn't. Without this, ConditionEnvironment=XDG_SESSION_CLASS=user
    -- (used by localsearch-3.service, the Tracker file indexer) never matches, so
    -- systemd skips the unit every time Nautilus tries to D-Bus-activate it —
    -- Nautilus then blocks ~2s waiting on the failed activation before opening.
    hl.exec_cmd("systemctl --user import-environment XDG_SESSION_CLASS XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP DISPLAY WAYLAND_DISPLAY")
    -- Only at start: running it per reload would leave a second monitor-setup.sh
    -- (and its event-socket watcher) running per reload.
    hl.exec_cmd("~/.config/hypr/monitor-setup.sh")
    -- Idle handling lives in hypridle.conf (lock, then DPMS off). Replaces swayidle,
    -- which had no DPMS timeout — panels stayed lit indefinitely behind the lock.
    hl.exec_cmd("hypridle")
    -- Polkit authentication agent. Hyprland does not process XDG autostart entries,
    -- and lxpolkit.desktop is OnlyShowIn=LXDE anyway, so it has to be started here —
    -- without it, GUI privilege prompts (blueman, virt-manager) fail silently.
    hl.exec_cmd("lxpolkit")
    hl.exec_cmd("waybar")
    hl.exec_cmd("mako")
    hl.exec_cmd("blueman-applet")
    -- blueman-applet (kept for its pairing agent) always spawns a full-colour tray icon,
    -- duplicating waybar's own Bluetooth key; its plugin-list setting doesn't stop it.
    hl.exec_cmd("sleep 8; pkill -f /usr/bin/blueman-tray")
    -- Supervised by systemd (Restart=on-failure): hyprpaper has aborted at login on
    -- some days, and nothing else would bring it back. UWSM starts it with
    -- graphical-session.target; this only covers a session started another way.
    hl.exec_cmd("systemctl --user start hyprpaper.service")
    hl.exec_cmd("~/.config/hypr/wallpaper-slideshow.sh")
end)


