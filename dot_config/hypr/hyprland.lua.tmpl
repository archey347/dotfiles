-- See https://wiki.hypr.land/Configuring/Basics/Variables/
hl.config({
    general = {
        -- Applied per window side, so half the outer gap keeps every gap on screen equal
        gaps_in  = 2,
        gaps_out = 4,

        border_size = 1,

        -- Translucent white reads as a faint edge over any window background
        col = {
            active_border   = "rgba(ffffff29)",
            inactive_border = "rgba(ffffff17)",
        },

        resize_on_border = true,
        allow_tearing    = false,

        layout = "dwindle",
    },

    decoration = {
        rounding       = 8,
        rounding_power = 3,

        active_opacity   = 1.0,
        inactive_opacity = 1.0,

        -- Windows sit flat: soft shadows fight the hard edges everywhere else
        shadow = {
            enabled = false,
        },

        blur = {
            enabled  = true,
            size     = 2,
            passes   = 1,
            vibrancy = 0.1696,
        },
    },

    animations = {
        enabled = true,
    },

    dwindle = {
        preserve_split = true,
    },

    master = {
        new_status = "master",
    },

    misc = {
        force_default_wallpaper = 0, -- No mascot wallpaper asset — hyprpaper covers it anyway
        disable_hyprland_logo   = true,
        -- If hyprlock dies (crash, bad config, etc) without releasing the session
        -- lock, Hyprland otherwise refuses to let a fresh hyprlock take over —
        -- every relaunch gets rejected and you're stuck locked out with no way
        -- back in short of a VT switch. This lets a new instance reclaim the lock.
        allow_session_lock_restore = true,
    },

    render = {
        -- 4K frames finish late in the refresh on the iGPU; without this a
        -- kernel flip trace showed ~24% of vblanks missed instead of ~10%
        new_render_scheduling = true,
    },

    debug = {
        disable_logs = true, -- Default. Flip to false only when chasing a bug.
    },
})

