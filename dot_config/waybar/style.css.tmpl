* {
    font-family: 'SF Pro Display', 'Inter', 'Cantarell', 'Noto Sans', sans-serif, 'Font Awesome 6 Free Solid', 'Font Awesome 6 Free', 'Font Awesome 6 Brands';
    font-size: 13px;
    min-height: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

window#waybar {
    background-color: rgba({{ .theme.background_rgb }}, 0.72);
    border: none;
    border-radius: 0;
    color: rgba({{ .theme.text_rgb }}, 0.88);
    transition-property: background-color;
    transition-duration: .3s;
    padding: 0 4px;
}

window#waybar.hidden {
    opacity: 0.2;
}

.modules-left,
.modules-center,
.modules-right {
    background-color: transparent;
}

button {
    box-shadow: none;
    border: none;
    border-radius: 8px;
    transition: all 0.2s ease;
}

button:hover {
    background: rgba({{ .theme.text_rgb }}, 0.1);
    box-shadow: none;
}

/* ── Pill base ──────────────────────────────────── */
/* Position, size, shape, and base color for every top-level module.
   Per-module overrides below should only touch what's actually different. */
#workspaces,
#window,
#clock,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#pulseaudio,
#wireplumber,
#custom-media,
#tray,
#mode,
#idle_inhibitor,
#scratchpad,
#power-profiles-daemon,
#mpd,
#mpris,
#custom-power,
#custom-vpn,
#custom-focus,
#privacy {
    background-color: transparent;
    color: rgba({{ .theme.text_rgb }}, 0.9);
    border: none;
    border-radius: 20px;
    margin: 4px 1px;
    /* Keeps the bar a constant 28px (20px pill + 4px margin top and bottom).
       Without the floor, module height follows the tallest glyph in its text,
       and characters resolve to whatever font fontconfig falls back to — e.g.
       Claude Code's ◐◑◒◓ terminal-title spinner renders ◐ in Font Awesome
       (16px line) but ◑◒◓ in Noto Sans Math (20px), which grew the bar, grew
       its exclusive zone, and shoved every window down the screen as the
       spinner ticked. Vertical padding is left off for the same reason: pills
       stretch to the bar height anyway, so padding would only add to the
       height the bar asks for and eat into the headroom this floor buys.
       (waybar's "height" config key does not help here — it is only a size
       request, and the bar still grows past it.) */
    padding: 0 10px;
    min-height: 20px;
    transition: all 0.2s ease;
}

/* ── Pill hover ─────────────────────────────────── */
/* Shared hover for plain info pills. Modules with their own
   hover treatment (custom-vpn, custom-focus, custom-power) override below. */
#clock:hover,
#battery:hover,
#cpu:hover,
#memory:hover,
#disk:hover,
#temperature:hover,
#backlight:hover,
#network:hover,
#pulseaudio:hover,
#wireplumber:hover,
#custom-media:hover,
#mode:hover,
#idle_inhibitor:hover,
#scratchpad:hover,
#power-profiles-daemon:hover,
#mpd:hover,
#mpris:hover {
    background-color: #{{ .theme.surface_hover }};
    color: rgba({{ .theme.text_rgb }}, 0.95);
}

/* ── Workspaces ─────────────────────────────────── */
#workspaces {
    padding: 0 3px;
}

#workspaces button {
    padding: 0 6px;
    background-color: transparent;
    color: rgba({{ .theme.text_rgb }}, 0.55);
    margin: 0 1px;
    min-width: 20px;
    border-radius: 14px;
    transition: all 0.2s ease;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    font-weight: 600;
}

#workspaces button:hover {
    background: rgba({{ .theme.text_rgb }}, 0.1);
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#workspaces button.focused,
#workspaces button.active {
    background-color: #{{ .theme.accent }};
    color: #{{ .theme.text }};
}

#workspaces button.urgent {
    background-color: rgba({{ .theme.error_rgb }}, 0.45);
    color: #{{ .theme.text }};
}

/* ── Window title ───────────────────────────────── */
#window {
    padding: 0 12px;
}

/* ── Clock ──────────────────────────────────────── */
#clock {
    font-weight: 600;
    color: rgba({{ .theme.text_rgb }}, 0.95);
    letter-spacing: 0.03em;
}

/* ── Battery ────────────────────────────────────── */
#battery {
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#battery.charging,
#battery.plugged {
    color: #{{ .theme.success }};
}

@keyframes blink {
    to { color: #{{ .theme.error }}; }
}

#battery.critical:not(.charging) {
    color: #{{ .theme.error }};
    animation-name: blink;
    animation-duration: 1s;
    animation-timing-function: steps(12);
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

/* ── Network ────────────────────────────────────── */
#network {
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#network.disconnected {
    color: #{{ .theme.error }};
}

/* ── Pulseaudio ─────────────────────────────────── */
#pulseaudio.muted {
    color: rgba({{ .theme.text_rgb }}, 0.55);
}

/* ── Temperature ────────────────────────────────── */
#temperature.critical {
    color: #{{ .theme.error }};
}

/* ── Power profiles ─────────────────────────────── */
#power-profiles-daemon.performance {
    background-color: rgba({{ .theme.error_rgb }}, 0.75);
    color: #{{ .theme.text }};
}

#power-profiles-daemon.balanced {
    background-color: transparent;
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#power-profiles-daemon.power-saver {
    background-color: rgba({{ .theme.success_rgb }}, 0.65);
    color: #{{ .theme.text }};
}

/* ── Tray ───────────────────────────────────────── */
#tray {
    padding: 0 6px;
}

#tray > widget {
    border-radius: 6px;
    margin: 0 3px;
    padding: 0 5px;
}

#tray > widget:hover {
    background-color: rgba({{ .theme.text_rgb }}, 0.08);
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background-color: rgba({{ .theme.error_rgb }}, 0.3);
}

/* ── Idle inhibitor ─────────────────────────────── */
#idle_inhibitor.activated {
    background-color: rgba({{ .theme.text_rgb }}, 0.15);
    color: #{{ .theme.text }};
}

/* ── Scratchpad ─────────────────────────────────── */
#scratchpad.empty {
    background-color: transparent;
    box-shadow: none;
}

/* ── Mode indicator ─────────────────────────────── */
#mode {
    background-color: rgba({{ .theme.text_rgb }}, 0.12);
}

label:focus {
    background-color: rgba(0, 0, 0, 0.2);
}

/* ── Focus mode ─────────────────────────────────── */
#custom-focus {
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#custom-focus.on {
    background-color: #{{ .theme.accent }};
    color: #{{ .theme.text }};
}

#custom-focus:hover {
    background-color: #{{ .theme.surface_hover }};
    color: rgba({{ .theme.text_rgb }}, 0.95);
}

#custom-focus.on:hover {
    background-color: rgba({{ .theme.accent_rgb }}, 0.75);
}

/* ── VPN ────────────────────────────────────────── */
#custom-vpn {
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#custom-vpn.connected {
    color: #{{ .theme.success }};
}

#custom-vpn:hover {
    background-color: #{{ .theme.surface_hover }};
    color: rgba({{ .theme.text_rgb }}, 0.95);
}

#custom-vpn.connected:hover {
    background-color: rgba({{ .theme.success_rgb }}, 0.45);
}

/* ── Custom power button ────────────────────────── */
#custom-power {
    color: rgba({{ .theme.text_rgb }}, 0.55);
}

#custom-power:hover {
    color: #{{ .theme.error }};
    background-color: rgba({{ .theme.error_rgb }}, 0.70);
    border-color: rgba({{ .theme.error_rgb }}, 0.75);
}

/* ── Privacy indicators ─────────────────────────── */
#privacy {
    padding: 0;
}

#privacy-item {
    padding: 0 5px;
    color: white;
}

#privacy-item.screenshare {
    background-color: rgba({{ .theme.accent_rgb }}, 0.6);
}

#privacy-item.audio-in {
    background-color: rgba({{ .theme.success_rgb }}, 0.6);
}

#privacy-item.audio-out {
    background-color: rgba({{ .theme.info_rgb }}, 0.6);
}

/* ── Wireplumber ────────────────────────────────── */
#wireplumber {
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#wireplumber.muted {
    color: #{{ .theme.error }};
}

/* ── MPD ────────────────────────────────────────── */
#mpd {
    color: rgba({{ .theme.text_rgb }}, 0.9);
}

#mpd.disconnected,
#mpd.stopped {
    color: rgba({{ .theme.text_rgb }}, 0.55);
}

/* ── Custom media ───────────────────────────────── */
#custom-media {
    color: rgba({{ .theme.text_rgb }}, 0.9);
    min-width: 100px;
}

/* ── Power menu popup ───────────────────────────── */
menu {
    background-color: rgba({{ .theme.background_rgb }}, 0.95);
    border: 1px solid rgba({{ .theme.text_rgb }}, 0.18);
    border-radius: 14px;
    padding: 4px;
    font-family: 'SF Pro Display', 'Inter', 'Cantarell', sans-serif;
    font-size: 13px;
    color: rgba({{ .theme.text_rgb }}, 0.9);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.8);
}

menuitem {
    border-radius: 8px;
    padding: 6px 12px;
    color: rgba({{ .theme.text_rgb }}, 0.85);
    transition: all 0.15s ease;
}

menu menuitem check,
menu menuitem radio {
    min-width: 0;
    min-height: 0;
}

menuitem:hover {
    background-color: rgba({{ .theme.text_rgb }}, 0.1);
    color: #{{ .theme.text }};
}
