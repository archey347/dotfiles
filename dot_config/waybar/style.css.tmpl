/* Every module is its own keycap: a solid right/bottom ledge marks what can be pressed.
   Groups are separated by spacing only. */
* {
    font-family: 'Montserrat', 'Font Awesome 6 Free Solid', 'Font Awesome 6 Free', 'Font Awesome 6 Brands', sans-serif;
    font-size: 12px;
    font-weight: 600;
    min-height: 0;
    font-feature-settings: "tnum";
}

window#waybar {
    background-color: rgba({{ .theme.background_rgb }}, 0.94);
    border: none;
    color: #{{ .theme.text }};
}

tooltip {
    background-color: #{{ .theme.surface }};
    border: 1px solid rgba({{ .theme.text_rgb }}, 0.35);
    border-radius: 6px;
}

tooltip label {
    color: #{{ .theme.text }};
}

button {
    border: none;
    border-radius: 6px;
    box-shadow: none;
}

#workspaces,
#io,
#system,
#toggles {
    background-color: transparent;
    border: none;
    margin: 0 8px;
    padding: 0;
}

#workspaces {
    margin-left: 6px;
}

/* Keycaps */
#workspaces button,
#pulseaudio,
#custom-network,
#custom-bluetooth,
#custom-vpn,
#cpu,
#memory,
#temperature,
#backlight,
#power-profiles-daemon,
#battery,
#clock,
#idle_inhibitor,
#custom-focus,
#tray,
#mpris,
#custom-power {
    background-color: #{{ .theme.surface }};
    color: #{{ .theme.text }};
    border: 1px solid rgba({{ .theme.text_rgb }}, 0.3);
    border-radius: 6px;
    box-shadow: 3px 3px 0 0 #{{ .theme.accent_strong }};
    margin: 5px 4px 8px 1px;
    padding: 0 8px;
}

#workspaces button:hover,
#pulseaudio:hover,
#custom-network:hover,
#custom-bluetooth:hover,
#custom-vpn:hover,
#backlight:hover,
#battery:hover,
#clock:hover,
#idle_inhibitor:hover,
#custom-focus:hover,
#power-profiles-daemon:hover,
#mpris:hover {
    background-color: #{{ .theme.surface_hover }};
    border-color: rgba({{ .theme.text_rgb }}, 0.65);
    box-shadow: 3px 3px 0 0 rgba({{ .theme.text_rgb }}, 0.65);
}

#clock {
    font-weight: 700;
    padding: 0 12px;
    margin-left: 9px;
    margin-right: 12px;
}

#tray {
    padding: 0 6px;
    margin-left: 9px;
}

#custom-power {
    margin-right: 8px;
}

/* Workspaces */
#workspaces button {
    color: rgba({{ .theme.text_rgb }}, 0.6);
    min-width: 14px;
    padding: 0 8px;
    font-weight: 700;
}

#workspaces button.active {
    background-color: rgba({{ .theme.accent_rgb }}, 0.35);
    border-color: #{{ .theme.accent }};
    box-shadow: 3px 3px 0 0 #{{ .theme.accent }};
    color: #{{ .theme.text }};
}

#workspaces button.visible:not(.active) {
    background-color: rgba({{ .theme.accent_rgb }}, 0.14);
    color: #{{ .theme.text }};
}

#workspaces button.urgent {
    background-color: rgba({{ .theme.error_rgb }}, 0.45);
    border-color: #{{ .theme.error }};
    box-shadow: 3px 3px 0 0 #{{ .theme.error }};
    color: #{{ .theme.text }};
}

#window {
    color: #{{ .theme.text }};
    margin: 5px 0 8px 0;
    padding: 0 8px;
}

/* States */
/* Switched-on toggles light up in slate so they don't compete with the gold workspace */
#custom-focus.on,
#idle_inhibitor.activated {
    background-color: rgba({{ .theme.info_rgb }}, 0.35);
    border-color: #{{ .theme.info }};
    box-shadow: 3px 3px 0 0 #{{ .theme.info }};
}

#custom-bluetooth.off,
#custom-bluetooth.on,
#custom-vpn.disconnected {
    color: rgba({{ .theme.text_rgb }}, 0.5);
}

#custom-network.disconnected,
#battery.warning:not(.charging),
#battery.critical:not(.charging),
#temperature.critical {
    color: #{{ .theme.error }};
}

#custom-power:hover {
    background-color: rgba({{ .theme.error_rgb }}, 0.45);
    border-color: #{{ .theme.error }};
    box-shadow: 3px 3px 0 0 #{{ .theme.error }};
}

/* Third-party tray icons can't be Font Awesome; ask GTK for their monochrome variants */
#tray {
    -gtk-icon-style: symbolic;
}

#tray > widget {
    padding: 0 4px;
}

#tray > .needs-attention {
    background-color: rgba({{ .theme.error_rgb }}, 0.45);
}

/* Power menu popup */
menu {
    background-color: #{{ .theme.surface }};
    border: 1px solid rgba({{ .theme.text_rgb }}, 0.35);
    border-radius: 8px;
    padding: 4px;
    color: #{{ .theme.text }};
}

menuitem {
    border: 1px solid transparent;
    border-radius: 6px;
    margin: 1px 3px 4px 0;
    padding: 6px 14px;
    color: #{{ .theme.text }};
}

menuitem:hover {
    background-color: rgba({{ .theme.accent_rgb }}, 0.35);
    border-color: #{{ .theme.accent }};
    box-shadow: 3px 3px 0 0 #{{ .theme.accent }};
}

/* Power mode is a state, so its colour stays on */
#power-profiles-daemon.performance {
    background-color: rgba({{ .theme.error_rgb }}, 0.45);
    border-color: #{{ .theme.error }};
    box-shadow: 3px 3px 0 0 #{{ .theme.error }};
}

#power-profiles-daemon.power-saver {
    background-color: rgba({{ .theme.success_rgb }}, 0.4);
    border-color: #{{ .theme.success }};
    box-shadow: 3px 3px 0 0 #{{ .theme.success }};
}

#power-profiles-daemon.performance:hover {
    background-color: rgba({{ .theme.error_rgb }}, 0.65);
}

#power-profiles-daemon.power-saver:hover {
    background-color: rgba({{ .theme.success_rgb }}, 0.6);
}
