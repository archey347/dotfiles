command = bash -l

font-family = Iosevka
font-size = 10

window-padding-x = 6
window-padding-y = 2

background = #{{ if hasKey . "theme" }}{{ .theme.background }}{{ else }}001a22{{ end }}
foreground = #{{ if hasKey . "theme" }}{{ .theme.text }}{{ else }}ebdbb2{{ end }}
background-opacity = 0.99

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration-features = cursor,sudo,title
scrollback-limit = 100000

# Allows ctrl+shirt+r history search
keybind = ctrl+shift+r=text:\x12
