window {
  margin: 0px;
  border: 1px solid rgba({{ .theme.text_rgb }}, 0.16);
  border-radius: 14px;
  /* Low enough that the layerrule blur in hyprland.conf actually shows through */
  background-color: rgba({{ .theme.background_rgb }}, 0.86);
  font-family: 'Noto Serif', 'Liberation Serif', serif;
  font-size: 15px;
  font-weight: 400;
}

#input {
  margin: 0px;
  border: none;
  border-bottom: 1px solid rgba({{ .theme.text_rgb }}, 0.1);
  border-radius: 0px;
  padding: 14px 18px;
  color: #{{ .theme.text }};
  background-color: transparent;
  outline: none;
  box-shadow: none;
}

#input:focus {
  border: none;
  border-bottom: 1px solid rgba({{ .theme.text_rgb }}, 0.1);
  outline: none;
  box-shadow: none;
}

#input image {
  color: rgba({{ .theme.text_rgb }}, 0.45);
  margin-right: 8px;
}

#inner-box {
  margin: 0px;
  border: none;
  background-color: transparent;
}

#outer-box {
  margin: 0px;
  border: none;
  background-color: transparent;
}

/* Margin lives here, not on #inner-box, or the selected row overruns the right edge */
#scroll {
  margin: 4px 8px 8px 8px;
  border: none;
}

/* hide_scroll=true would do this, but it also lets rows overflow sideways */
scrollbar {
  opacity: 0;
}

#text {
  color: #{{ .theme.text }};
  margin: 0px 0px 0px 10px;
}

#entry {
  padding: 6px 12px;
  margin: 1px 4px;
  border: none;
  border-radius: 8px;
  background-color: transparent;
  outline: none;
  transition: background-color 120ms ease;
}

#entry:focus,
#entry:hover,
#entry:selected:focus {
  outline: none;
  border: none;
  box-shadow: none;
}

#entry:selected {
  background-color: rgba({{ .theme.accent_rgb }}, 0.35);
  outline: none;
  border: none;
  box-shadow: none;
}

#entry:selected #text {
  color: #{{ .theme.text }};
}

#entry image {
  -gtk-icon-transform: scale(0.9);
}
