* {
  font-family: 'Montserrat', 'Font Awesome 6 Free Solid', 'Font Awesome 6 Free', 'Font Awesome 6 Brands', sans-serif;
}

window {
  margin: 0px;
  border: 1px solid rgba({{ .theme.text_rgb }}, 0.35);
  border-radius: 12px;
  background-color: rgba({{ .theme.background_rgb }}, 0.96);
}

#outer-box {
  margin: 0px;
  border: none;
  background-color: transparent;
}

#input {
  margin: 12px 12px 10px 12px;
  border: 1px solid rgba({{ .theme.text_rgb }}, 0.3);
  border-radius: 8px;
  padding: 10px 14px;
  color: #{{ .theme.text }};
  background-color: #{{ .theme.surface }};
  font-size: 15px;
  font-weight: 600;
  outline: none;
  box-shadow: none;
}

/* A field, not a button: flat and neutral, so gold stays reserved for the selection */
#input,
#input:focus {
  border: 1px solid rgba({{ .theme.text_rgb }}, 0.3);
  outline: none;
}

#input image {
  color: rgba({{ .theme.text_rgb }}, 0.6);
  margin-right: 8px;
}

#inner-box {
  margin: 0px;
  border: none;
  background-color: transparent;
}

#scroll {
  margin: 0px 12px 12px 12px;
  border: none;
}

scrollbar {
  opacity: 0;
}

#text {
  color: #{{ .theme.text }};
  margin: 0px 0px 0px 12px;
  font-size: 15px;
  font-weight: 600;
}

/* Rows are flat until selected, then stand up as a keycap */
#entry {
  padding: 6px 12px;
  margin: 1px 7px 4px 0px;
  border: 1px solid transparent;
  border-radius: 8px;
  background-color: transparent;
  outline: none;
}

#entry:focus,
#entry:selected:focus {
  outline: none;
}

#entry:hover {
  background-color: #{{ .theme.surface_hover }};
  border: 1px solid rgba({{ .theme.text_rgb }}, 0.5);
  box-shadow: 3px 3px 0px 0px rgba({{ .theme.text_rgb }}, 0.5);
  outline: none;
}

#entry:selected {
  background-color: rgba({{ .theme.accent_rgb }}, 0.24);
  border: 1px solid #{{ .theme.accent }};
  box-shadow: 3px 3px 0px 0px #{{ .theme.accent }};
  outline: none;
}

#entry:selected #text {
  color: #{{ .theme.text }};
  font-weight: 700;
}
