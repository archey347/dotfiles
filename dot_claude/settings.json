{
  "permissions": {
    "allow": [
      "Read(~/dev/**)",
      "Read(~/d/**)",
      "Bash(ls:*)",
      "Bash(find:~/dev/*)",
      "Bash(find:~/d/*)",
      "Bash(grep:~/dev/*)",
      "Bash(grep:~/d/*)",
      "Bash(cat:~/dev/*)",
      "Bash(cat:~/d/*)",
      "Bash(zcat:~/dev/*)",
      "Bash(zcat:~/d/*)",
      "Bash(head:~/dev/*)",
      "Bash(head:~/d/*)",
      "Bash(tail:~/dev/*)",
      "Bash(tail:~/d/*)",
      "Bash(wc:~/dev/*)",
      "Bash(wc:~/d/*)",
      "Bash(file:~/dev/*)",
      "Bash(file:~/d/*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)"
    ]
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "agentPushNotifEnabled": true,
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[.title // \"Claude Code\", .cwd, .message] | @tsv' | { IFS=\"$(printf '\\t')\" read -r title cwd msg; notify-send -a \"Claude Code\" -u normal \"${title} · $(basename \"${cwd:-$PWD}\")\" \"$msg\"; }"
          }
        ]
      }
    ]
  }
}
