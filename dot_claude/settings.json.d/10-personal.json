{
  "model": "claude-opus-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Scouting",
      "Jibbling",
      "Bikeshedding",
      "Procrastinating",
      "Puppeting"
    ]
  },
  "agentPushNotifEnabled": true,
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[.title // \"Claude Code\", .cwd, .message] | @tsv' | { IFS=\"$(printf '\\t')\" read -r title cwd msg; notify-send -a \"Claude Code\" -u normal \"${title} · $(basename \"${cwd:-$PWD}\")\" \"$msg\"; }"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
