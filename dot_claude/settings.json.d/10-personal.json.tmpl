{{- $settings := `{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Scouting",
      "Jibbling",
      "Bikeshedding",
      "Procrastinating",
      "Puppeting"
    ]
  },
  "agentPushNotifEnabled": true,
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[.title // \"Claude Code\", .cwd, .message] | @tsv' | { IFS=\"$(printf '\\t')\" read -r title cwd msg; notify-send -a \"Claude Code\" -u normal \"${title} · $(basename \"${cwd:-$PWD}\")\" \"$msg\"; }"
          }
        ]
      }
    ]
  }
}` | fromJson -}}
{{- if ne .claude_default_model "default" -}}
{{-   $_ := set $settings "model" .claude_default_model -}}
{{- end -}}
{{- if ne .claude_subagent_model "inherit" -}}
{{-   $_ := set $settings "env" (dict "CLAUDE_CODE_SUBAGENT_MODEL" .claude_subagent_model) -}}
{{- end -}}
{{ toPrettyJson "  " $settings -}}
